{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anchorpass.invalid/spec/bundle.schema.json",
  "title": "Anchorpass signed envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["key_id", "payload", "signature"],
  "properties": {
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "payload": {"type": "string", "contentEncoding": "base64"},
    "signature": {"type": "string", "contentEncoding": "base64"}
  },
  "$defs": {
    "field": {"type": "string", "minLength": 1, "maxLength": 16384},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "protocol_family", "revision", "issued_at", "expires_at", "fields"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "protocol_family": {"type": "string", "const": "recaptcha-v3/1"},
        "revision": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
        "issued_at": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "expires_at": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "hl", "size", "chr", "vh", "bg"],
          "properties": {
            "reason": {"$ref": "#/$defs/field"},
            "hl": {"$ref": "#/$defs/field"},
            "size": {"$ref": "#/$defs/field"},
            "chr": {"$ref": "#/$defs/field"},
            "vh": {"$ref": "#/$defs/field"},
            "bg": {"$ref": "#/$defs/field"}
          }
        }
      }
    }
  }
}
